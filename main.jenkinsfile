pipeline {
    agent any

    environment {
        REGISTRY = "omkarrathod123"
        IMAGE_NAME = "findmycontry"
        DB_CONN = "Server=(localdb)\\mssqllocaldb;Database=FindMyCountryDB;Trusted_Connection=True;MultipleActiveResultSets=true"
        SOLUTION = "FindMyCountry.slnx"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/omkarrathod123/Find-My-Country.git'
            }
        }
    }
        stage('Restore') {
            steps {
                script {
                    sh "msbuild $SOLUTION /t:Restore"
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh "msbuild $SOLUTION /p:Configuration=Release"
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    sh """
                        docker build \
                          --build-arg DB_CONN="$DB_CONN" \
                          -t $REGISTRY/$IMAGE_NAME:\$BUILD_NUMBER .
                    """
                }
            }
        }

        stage('Push Image') {
            steps {
                script {
                    sh """
                        docker push $REGISTRY/$IMAGE_NAME:\$BUILD_NUMBER
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}